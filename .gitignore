# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec.bak

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs ("logs/*" not "logs/": a whole ignored DIRECTORY cannot be dug into,
# so nothing inside it could be re-included below)
logs/*
*.log

# ...but keep the curated OCR sample corpus: labelled captures are the
# regression suite for the log parser (tools/ocr_replay.py). Raw session
# noise (the binarized *_ocr.png companions, raw OCR text) stays out.
!logs/ocr_samples/
!logs/ocr_samples/**/
!logs/ocr_samples/**/*.png
logs/ocr_samples/**/*_ocr.png
logs/ocr_samples/**/*.txt

# Config (optional - uncomment if you don't want to track user configs)
# config.json

# OS files
.DS_Store
Thumbs.db

# Test files
test_*.py
*_test.py
tests/

# Temporary files
*.tmp
*.temp
tmp/
temp/
